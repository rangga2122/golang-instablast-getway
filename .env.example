# App Settings
APP_PORT=3000
APP_HOST=0.0.0.0
APP_DEBUG=false

# Trial Registration
TRIAL_ACTIVE_DAYS=3
TRIAL_MAX_DEVICES=1
TRIAL_SIGNUP_WINDOW_MINUTES=60
TRIAL_SIGNUP_MAX_ATTEMPTS_PER_IP=5
TRIAL_SIGNUP_SUCCESS_WINDOW_DAYS=30
TRIAL_SIGNUP_MAX_SUCCESS_PER_IP=1
TRIAL_SIGNUP_MIN_FORM_SECONDS=2
TRIAL_BLOCKED_EMAIL_DOMAINS=
TRIAL_OTP_ENABLED=true
TRIAL_OTP_TTL_MINUTES=5
TRIAL_OTP_MAX_VERIFY_ATTEMPTS=5

# Database (SQLite)
DB_URI=file:storages/whatsapp.db?_foreign_keys=on

# Optional fallback API key for InstaBlast AI
NVIDIA_API_KEY=
WHATSAPP_AI_MODEL=openai/gpt-oss-120b
WHATSAPP_AI_MAX_TOKENS=512
WHATSAPP_AI_REQUEST_TIMEOUT_SEC=90
